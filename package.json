{
  "name": "AiEnrichedDataProducts",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/http-client": "^4.7.0",
    "@sap/cds": "9.9.1",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9.9.1",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-aienricheddataproductsui": "cds watch --open aienricheddataproductsui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "postinstall": "rm -rf node_modules/@sap/cds-dk/node_modules/@sap/cds"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/aienricheddataproductsui"
  ],
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      },
      "destinations": true,
      "html5-repo": true
    }
  }
}
